{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "algorithm_summary", "files_changed", "hyperparameter_configs", "selected_config", "next_algorithms", "risks"],
  "properties": {
    "status": {"type": "string", "enum": ["implemented", "needs_review", "failed"]},
    "algorithm_summary": {"type": "string"},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "hyperparameter_configs": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "solution_path"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "solution_path": {"type": "string"}
        }
      }
    },
    "selected_config": {"type": ["string", "null"]},
    "next_algorithms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm_family", "version_suffix", "focus", "hypothesis", "implementation_base", "structural_change", "evidence"],
        "properties": {
          "algorithm_family": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "version_suffix": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "focus": {"type": "string", "enum": ["linear", "attention", "format", "combined"]},
          "hypothesis": {"type": "string"},
          "implementation_base": {"type": "string", "enum": ["parent", "v0", "scratch"]},
          "structural_change": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
