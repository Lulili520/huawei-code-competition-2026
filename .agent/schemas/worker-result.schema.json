{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "algorithm_summary", "files_changed", "hyperparameter_configs", "selected_config", "diagnostics", "risks"],
  "properties": {
    "status": {"type": "string", "enum": ["implemented", "needs_review", "failed"]},
    "algorithm_summary": {"type": "string"},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "hyperparameter_configs": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "solution_path"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "solution_path": {"type": "string"}
        }
      }
    },
    "selected_config": {"type": ["string", "null"]},
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signals", "hook_implemented", "limitations"],
      "properties": {
        "signals": {"type": "array", "items": {"type": "string"}},
        "hook_implemented": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
