    {
      "id": "immutable_evaluator_boundary",
      "statement": "算法 Agent 只能修改自己的版本目录；评测器、评分公式、数据清单与调度器在一次运行中必须保持哈希不变。",
      "rationale": "把代码改进与评分口径隔离，避免把评测污染误判为算法收益。",
      "status": "core",
      "support_count": 1,
      "contradiction_count": 0,
      "sources": [
        {
          "system": "AutoSOTA",
          "year": 2026,
          "url": "https://github.com/tsinghua-fib-lab/AutoSOTA"
        }
      ]
    },
    {
      "id": "screen_then_confirm",
      "statement": "内部配置先用固定代表性子集筛选，只让领先配置进入完整 300 例正式评测；正式登记只接受完整评测结果。",
      "rationale": "多保真门禁减少明显无效候选占用昂贵正式评测的时间，同时保留统一最终口径。",
      "status": "core",
      "support_count": 2,
      "contradiction_count": 0,
      "sources": [
